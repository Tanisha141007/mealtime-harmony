# Supabase project - auth (phone OTP). The anon/publishable key is safe to
# expose client-side by design; row-level security on the backend is what
# actually protects data, not secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the caspian_buildathon API (M4) - defaults to local dev.
VITE_API_BASE_URL=http://localhost:8000
