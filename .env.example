# Supabase project - auth (email magic link). The anon/publishable key is
# safe to expose client-side by design; row-level security on the backend
# is what actually protects data, not secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the caspian_buildathon API - defaults to local dev
# (app/api/main.py, port 8001 - see caspian_buildathon/.claude/launch.json).
# Set to the deployed Render URL in production (see .github/workflows/deploy.yml).
VITE_API_BASE_URL=http://localhost:8001
